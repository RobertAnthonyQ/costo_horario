  usuario_id      String?       @db.Uuid
  fecha_calculo   DateTime?     @default(now()) @db.Timestamptz(6)
  horas_json      Json?
  resultados_json Json?
  comentario      String?
  machines        machines      @relation(fields: [machine_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           public_users? @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("posesion_historial")
  @@schema("public")
}

